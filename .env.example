# Preparation example. Setup must replace every GENERATE_WITH_SETUP sentinel.
# All application settings require an app restart after changes.
NODE_ENV=production
DEPLOYMENT_MODE=local
PORT=3000
# Container connection; native development needs a separately authored host URL.
DATABASE_URL='postgresql://agentfiles:GENERATE_WITH_SETUP@db:5432/agentfiles'
# App-owned container storage directory; runtime ownership checks are required.
STORAGE_ROOT=/data/storage
SESSION_SECRET=GENERATE_WITH_SETUP
ADMIN_USERNAME=admin
# Single quotes preserve Argon2 dollar signs in Node and Compose env files.
ADMIN_PASSWORD_HASH='GENERATE_WITH_SETUP'
PUBLIC_BASE_URL=http://localhost:3000
# Public mode only: comma-separated reviewed proxy IP addresses/CIDRs.
TRUST_PROXY=
# File retention in days; persistence requires explicit administrator policy.
RETENTION_DAYS=7
ALLOW_PERSISTENT_FILES=false
# Bytes: 1 GiB per upload, 10 GiB managed capacity, 1 GiB disk reserve.
MAX_UPLOAD_BYTES=1073741824
MAX_STORAGE_BYTES=10737418240
MIN_FREE_DISK_BYTES=1073741824
MAX_CONCURRENT_UPLOADS=4
# Seconds; orphan grace must be at least 600 and twice the cleanup interval.
CLEANUP_INTERVAL_SECONDS=3600
ORPHAN_GRACE_SECONDS=86400
CLEANUP_BATCH_SIZE=100
# Days: deleted file details/events only; issued codes are never purged/reused.
METADATA_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=30
# Compose-only settings; never expose these via instance JSON or VITE_ variables.
POSTGRES_PASSWORD=GENERATE_WITH_SETUP
APP_PORT=3000
# Optional host mapping for tool-container setup, where supported.
# SETUP_UID=1000
# SETUP_GID=1000
# COMPOSE_PROJECT_NAME=agentfiles
